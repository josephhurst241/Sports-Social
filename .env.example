# Copy to .env.local and fill in to turn on player accounts and career
# history. Without them the game runs as before, everyone a guest.
#
# Supabase dashboard -> Project Settings -> API (or "Connect"):
#   Project URL, and the publishable key (sb_publishable_..., or the legacy anon key).
# Both are meant for the browser: row level security and the record_game()
# function (supabase/migrations) protect the data.
# Never put the service_role / secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
